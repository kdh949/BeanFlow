otelcol.receiver.otlp "beanflow" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.beanflow.input]
    logs   = [otelcol.processor.batch.beanflow.input]
  }
}

otelcol.processor.batch "beanflow" {
  timeout         = "1s"
  send_batch_size = 1024

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
    logs   = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  sending_queue {
    enabled    = true
    queue_size = 2048
    sizer      = "requests"
  }

  debug_metrics {
    disable_high_cardinality_metrics = true
  }

  client {
    endpoint = sys.env("BEANFLOW_TEMPO_OTLP_HTTP_ENDPOINT")
  }
}

otelcol.exporter.otlphttp "loki" {
  sending_queue {
    enabled    = true
    queue_size = 2048
    sizer      = "requests"
  }

  debug_metrics {
    disable_high_cardinality_metrics = true
  }

  client {
    endpoint = sys.env("BEANFLOW_LOKI_OTLP_HTTP_ENDPOINT")
  }
}
